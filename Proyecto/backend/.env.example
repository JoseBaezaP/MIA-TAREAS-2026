# Copiar a .env y completar. El archivo .env NUNCA se sube al repositorio.

# Rutas (opcional: por defecto se usan Proyecto/assets y Proyecto/data)
# VETRAG_RUTA_ASSETS=/ruta/a/assets
# VETRAG_RUTA_DATA=/ruta/a/data

# F2: embeddings
VETRAG_VOYAGE_API_KEY=
# VETRAG_LIMITE_TOKENS_VOYAGE=190000000

# F2+: base de datos
VETRAG_DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/vetrag

# F3: agente
VETRAG_OPENAI_API_KEY=
# VETRAG_MODELO_LLM=gpt-5.6-luna
# VETRAG_ESFUERZO_RAZONAMIENTO=low
# VETRAG_FRAGMENTOS_POR_BUSQUEDA=8
# VETRAG_MAX_BUSQUEDAS=2

# F4: API y login (generar el secreto con: openssl rand -hex 32)
VETRAG_JWT_SECRETO=
# VETRAG_HORAS_DE_SESION=8
# VETRAG_COOKIE_SEGURA=false   # true en el servidor (HTTPS)
VETRAG_USUARIOS_INICIALES='[{"email": "correo@ejemplo.com", "password": "cambiar"}]'
