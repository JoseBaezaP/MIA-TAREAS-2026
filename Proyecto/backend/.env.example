# Copiar a .env y completar. El archivo .env NUNCA se sube al repositorio.

# Rutas (opcional: por defecto se usan Proyecto/assets y Proyecto/data)
# VETRAG_RUTA_ASSETS=/ruta/a/assets
# VETRAG_RUTA_DATA=/ruta/a/data

# F2: embeddings
# VETRAG_VOYAGE_API_KEY=

# F2+: base de datos
# VETRAG_DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/vetrag
