# Copiar a infra/.env EN EL SERVIDOR y completar. Nunca se sube al repositorio.

# Contraseña de la base de datos de VetRAG (generar con: openssl rand -hex 24)
VETRAG_DB_PASSWORD=
# Puerto local donde escucha la app (nginx reenvía a 127.0.0.1:<puerto>)
VETRAG_PUERTO=8000

# APIs
VETRAG_OPENAI_API_KEY=
VETRAG_VOYAGE_API_KEY=

# Sesiones (generar con: openssl rand -hex 32)
VETRAG_JWT_SECRETO=
# Usuarios (se aplican con: docker compose exec app vetrag-usuarios sincronizar)
VETRAG_USUARIOS_INICIALES='[{"email": "correo@ejemplo.com", "password": "cambiar"}]'
